# Signaltower local environment — copy to .env and fill in the real values.
# .env is gitignored. The key's source of truth is your password manager;
# paste it from there. Never print it (no cat, no echo).

# API key for the X-API-Key header (preferred) or the ?key= query param.
SIGNALTOWER_API_KEY=

# Production server URL (for outgoing curl tests from this Mac).
SIGNALTOWER_URL=http://<host>:5000
